# ─────────────────────────────────────────────────────────────────────────────
# MongoDB Configuration
# ─────────────────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/coop-map
# For MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/coop-map?retryWrites=true&w=majority

# ─────────────────────────────────────────────────────────────────────────────
# Elasticsearch Configuration
# ─────────────────────────────────────────────────────────────────────────────
ELASTICSEARCH_NODE=http://localhost:9200
# For Elastic Cloud:
# ELASTICSEARCH_NODE=https://your-deployment.es.us-central1.gcp.cloud.es.io:9243

# Authentication (choose one method)
# Method 1: Username/Password
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=changeme

# Method 2: API Key (recommended for production)
# ELASTICSEARCH_API_KEY=your-base64-encoded-api-key

# ─────────────────────────────────────────────────────────────────────────────
# Next.js Configuration
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# ─────────────────────────────────────────────────────────────────────────────
# Future: Spring Boot API Configuration
# ─────────────────────────────────────────────────────────────────────────────
# SPRING_BOOT_API_URL=http://localhost:8080/api
# SPRING_BOOT_API_KEY=your-api-key

# ── Elasticsearch ───────────────────────────────────────────────────────────
# URL of the Elasticsearch cluster.  For local development, start with:
#   docker run -d --name elasticsearch -p 9200:9200 \
#     -e "discovery.type=single-node" \
#     -e "xpack.security.enabled=false" \
#     docker.elastic.co/elasticsearch/elasticsearch:9.3.2
ELASTICSEARCH_URL=http://localhost:9200

# Optional API key for authenticated Elastic Cloud or secured clusters.
# Leave commented out for unauthenticated local clusters.
# ELASTICSEARCH_API_KEY=VnVhQ2ZHY0JDZGViZWtD...

# ── MongoDB ─────────────────────────────────────────────────────────────────
# MongoDB connection string.  For local development:
#   docker run -d --name mongodb -p 27017:27017 mongo:8
MONGODB_URI=mongodb://localhost:27017/coop_companies

# ── Next.js ─────────────────────────────────────────────────────────────────
# Uncomment to see the URL origin in server logs.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
